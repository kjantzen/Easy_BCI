%BYB_Snake - an object for running a basic snake game
%
%Creates and updates the position of a snake drawn as a set of colored
%circles in an a Matlab axis. 
%
%mySnake BYB_Snake(ax) - initializes a new instance of the snake game 
% call mySnake the will be drawn in the matlab axis ax.  The snake is a
% train of dots that are drawn into the axis.  The position of the dots is
% updated on each call to the Move method.  The length of the snake is
% increased by 1 each time the snake turns.  The Snake game ends when the
% snake contacts one of the axes walls or when it comes into contact with
% any part of itself (2 dots attempt to occupy the same location).
%
% Properties
%   Axis -> the axes the snake is potted in.
%
%   Snake -> A scatter plot object containing information about each of the
%   markers that make up the snake body.  The user has access to all the
%   properties of this scatter plot objec (see MATLAB scatter plot).
%
%   SuccessSignal -> a structure containing parameters for generating the 
%   signal that the user successfully completed the game.
%
%   FailSignal -> a structure containing parameters for generating the
%   signal that the user failed the game
%   
%   SuccessLength -> the length of the snake used to define success.  The
%   user will have considered to have succeeded if the snake reaches this
%   length.
%
%   SnakeSpeed -> the size of the step the snake takes on each call to
%   Move.  Larger steps make the snake move faster.  Default is 3.
%
% Read Only Properties
%   Version - self explanatory
%   
%   Score - the current score for the user.  This value is updated during
%   game play and can be reset by reseting the game (see Reset() methods).
%   The score is calcluted on each Move as the current score plus the snake
%   length * 10.
%   
%   HighScore - the highest score recorded since object creation.  This
%   information is not stored after object deletion.
%   
%   SnakeLength -> the current length of the snake
%   
%   SnakeDataX  -> the X axis values for each element of the snake 
%   
%   SnakeDataY  -> The Y axis valyes for each element of the snake
%   
%   SnakeDirection = the current direction of the snake.  Thi is the
%   direction it will move on the next call to Move.  It can be one of N,
%   S, E or W.
%   
%   SnakeState -> the operational state of the game.  The SnakeSate in an
%   integer value in the range 0 to 4 where each integer maps onto the
%   following states:
%        IDLE = 0 -> game is ready but not currently running
%        BUSY = 1 -> game us currentlt calculating or rendering and cannot 
%                   accept commands
%        RUNNING = 2 -> operating and waitning for a Move command;
%        SUCCESS = 3 -> game has ended with successful completion
%        FAIL =  -> game ended with failed completion.
%
%   The game will only accept Move commands when in the RUNNING state. To
%   begin again after entering the SUCCESS or FAIL the game must be reset to 
%   an IDLE state using the the Reset() Method.  When in the IDLE state, the 
%   game can be started using the Start() method which places it in the 
%   RUNNING mode.
%
% Methods
%   Reset() -> resets the snake to initial conditions and puts the game in
%   the IDLE state.  Reset returns the snake to its initial starting
%   position, sets the direction to North and puts the game in idle state.
%   Once reset the game begins with a call to Start().
%    
%   Start() -> Starts the game changing from IDLE to RUNNING state.  Calls 
%   to Start() are ignored If the game is in any state other than IDLE (
%   BUSY, FAIL, SUCCESS, etc).
%
%   Move(dir) -> advances the snake on the screen.  The dir parameter
%   indicates if the snake should change directions on that move.  If
%   dir='Left' the snake will move left 90 degrees (e.g. change from moving  
%   North to West) and if dir='Right' the snake will move right 90 degrees (e.g. 
%   change from moving West to moving North).  If dir is any other value
%   the snake will continue in its current direciton.
%
% See also scatter, BCI_Maze, easy_bci
classdef BCI_Snake < handle
    properties
        Axis;
        Snake;
        SuccessSignal = struct(Color = "#00FF00", NFlashes = 3, FlashInterval = .25);
        FailSignal = struct(Color = "#FF0000", NFlashes = 3, FlashInterval = .25);
        SuccessLength = 40;
    end
    properties (Access = private)   
        Limits = [0,0,100,100];
        StartPosition = [50,50];
        SnakeDotSizeMin = 30;
        SnakeDotSizePoints = 30;
        Direction;
        InternalState = 0;
        Speed = 1;
        LastTurnTime = 1;
    end
    properties (SetAccess = private)
        Version = 1.1;
        Score = 0;
        HighScore = 0;
        SnakeLength = 10;
        SnakeDataX;
        SnakeDataY;
    end
    properties (Constant = true, Access = private)
        StartLength = 10;
        Directions = {'N', "E", "S", "W"};
        IDLE = 0;
        BUSY = 1;
        RUNNING = 2;
        SUCCESS = 3;
        FAIL = 4;
    end
    properties (Dependent)
        SnakeDirection;
        SnakeState;
        SnakeSpeed;
    end
    methods
        %% contructor
        function obj = BCI_Snake(Axis)
            obj.Axis = Axis;
            obj.Axis.XLim = [obj.Limits(1),obj.Limits(3)];
            obj.Axis.YLim = [obj.Limits(2),obj.Limits(4)];
            
            obj.Axis.Interactions = [];
            obj.Axis.HitTest = false;
            obj.Axis.PickableParts = 'none';

            drawnow
            pause(.5);

            obj.Snake = scatter(obj.Axis, obj.SnakeDataX, obj.SnakeDataY);
            obj.Snake.SizeData = obj.SnakeDotSizePoints;
            obj.Snake.CData = 1:obj.SnakeLength;
            obj.Snake.MarkerFaceColor = 'flat';
            obj.Snake.AlphaData = .5;

            obj.Reset();

            obj.Axis.XGrid = 'on';
            obj.Axis.YGrid = 'on';
            obj.Axis.XAxis.Visible = 'off';
            obj.Axis.YAxis.Visible = "off";  
        end
        %% ****************************************************************
        function Move(obj, direction)

            %ignore subsequent requests if the system is busy or the game
            %has ended
            if (obj.InternalState ~= obj.RUNNING)
                fprintf('NOPE');
                return; 
            end

            %get this value before we update it
            lastTurnTime = obj.LastTurnTime;

            obj.InternalState = obj.BUSY;
            %keep track of which direction the snake is travelling 
            %can be either N, S, E or W
            if strcmp(direction,'Left')
                obj.Direction = obj.Direction - 1;
                obj.SnakeLength = obj.SnakeLength + 1;
                if obj.Direction < 1, obj.Direction = 4; end
                obj.LastTurnTime = tic();
            elseif strcmp(direction,'Right')
                obj.Direction = obj.Direction + 1;
                obj.SnakeLength = obj.SnakeLength + 1;
                if obj.Direction > 4; obj.Direction = 1; end
                obj.LastTurnTime = tic();
            end

            %create the snake tail by shifting  all the existing values down by 1
            obj.SnakeDataX(2:obj.SnakeLength) = obj.SnakeDataX(1:obj.SnakeLength-1);
            obj.SnakeDataY(2:obj.SnakeLength) = obj.SnakeDataY(1:obj.SnakeLength-1);
           
            %get the new direction by adjusting current values by the
            %object speed
            switch obj.Directions{obj.Direction}
                case "N"
                    obj.SnakeDataY(1) = obj.SnakeDataY(1) + obj.Speed;
                    if obj.SnakeDataY(1) > obj.Limits(4); obj.SnakeDataY(1) = obj.Limits(4); end
                case "S"
                    obj.SnakeDataY(1) = obj.SnakeDataY(1) - obj.Speed;
                    if obj.SnakeDataY(1) < obj.Limits(2); obj.SnakeDataY(1) = obj.Limits(2); end
                case "E"
                    obj.SnakeDataX(1) = obj.SnakeDataX(1) + obj.Speed;
                    if obj.SnakeDataX(1) > obj.Limits(3); obj.SnakeDataX(1) = obj.Limits(3); end
                case "W"
                    obj.SnakeDataX(1) = obj.SnakeDataX(1) - obj.Speed;
                    if obj.SnakeDataX(1) < obj.Limits(1); obj.SnakeDataX(1) = obj.Limits(1); end
            end


            speedFactor = 1/toc(obj.LastTurnTime);
            obj.Score = obj.Score + (10 * obj.SnakeLength * speedFactor);
            obj.HighScore = max(obj.Score, obj.HighScore);
            if obj.isSelfCollision(obj.SnakeDataX, obj.SnakeDataY)
                fail(obj);
            end
            obj.Snake.XData = obj.SnakeDataX;
            obj.Snake.YData = obj.SnakeDataY;
            obj.Snake.CData = 1:obj.SnakeLength;

            obj.Axis.XLim = [obj.Limits(1),obj.Limits(3)];
            obj.Axis.YLim = [obj.Limits(2),obj.Limits(4)];
            %return the state to a running one unless the game ended
            if (obj.SnakeLength > obj.SuccessLength)
                obj.InternalState = obj.SUCCESS;
                success(obj);
            end
            if (obj.InternalState == obj.BUSY)
                obj.InternalState = obj.RUNNING;
            end
            drawnow
        end
        %% setter for the fail signal parameters
        function set.FailSignal(obj, val)
            %parameters are color, nflahses and flashinterval
            if val.NFlashes < 1 || val.NFlashes > 10
                error('EASYBCI:invalid_range','Number of flashes must be between 1 and 10');
            end
            try
                newcol = validatecolor(val.Color, 'one');
            catch ME
                error('EASYBCI:invalid_color_identifier','Color must be a valid MATLAB color specifier!');
            end
            val.Color = newcol;
            if ~isnumeric(val.FlashInterval) || val.FlashInterval <= 0 || val.FlashInterval >1
                error('EASYBCI:invalid_range', 'Flash interval must be a real positive value less than 1');
            end

            obj.FailSignal = val;
        end
        %% setter for the speed
        function set.SnakeSpeed(obj, val)
            
            if isnumeric(val) 
                val = round(val);
                if val < 1
                    val = 1;
                end
                obj.Speed = val;
            end
        end
        %% getter for the speed
        function s = get.SnakeSpeed(obj)
            s = obj.Speed;
        end
        %% getter for the direction
        function d = get.SnakeDirection(obj)
            d = obj.Directions(obj.Direction);
        end
        %% getter for the current operational state of the game
        function s = get.SnakeState(obj)
            s = obj.InternalState;
        end
                %% start the game
        function Start(obj)
            % don't let the user change the state if currently busy
            if obj.InternalState ~= obj.BUSY
                obj.InternalState = obj.RUNNING;
                obj.LastTurnTime = tic();
            end
        end
        %% reset the state of the game to initial conditions
        function Reset(obj)
            obj.SnakeLength = obj.StartLength;
            obj.SnakeDataX = ones(1,obj.SnakeLength) * obj.StartPosition(1);
            obj.SnakeDataY = ones(1,obj.SnakeLength) * obj.StartPosition(2);
            obj.Direction = 1;   
            obj.Score = 0;
            obj.InternalState = obj.IDLE;
            obj.SnakeDotSizePoints = getSnakeDotSize(obj);
            obj.Snake.SizeData = obj.SnakeDotSizePoints;
        end
    end
    methods (Access = private)
        function collided = isSelfCollision(~, X,Y)
            % a collision occurs if there is any overlap of 
            %x and y values
            if sum(X(2:end) == X(1) & Y(2:end) == Y(1)) > 0
                collided = true;
            else 
                collided = false;
            end            
        end
        function success(obj)
            obj.InternalState = obj.SUCCESS;
            flash_snake(obj, obj.SuccessSignal);
        end
        function fail(obj)
            obj.InternalState = obj.FAIL;
            flash_snake(obj, obj.FailSignal);
        end
        function flash_snake(obj, signalInfo)
            cBackup = obj.Snake.CData;
            for ii = 1:signalInfo.NFlashes
                obj.Snake.CData = validatecolor(signalInfo.Color,'one');
                pause(signalInfo.FlashInterval);
                obj.Snake.CData = cBackup;
                pause(signalInfo.FlashInterval)
            end

        end
        %calculates the size of dot based on the speed and axes dimenions
        function ds = getSnakeDotSize(obj)

            cUnits = obj.Axis.Units;
            obj.Axis.Units = 'points';
            aSize = obj.Axis.Position;
            pw = aSize(3);
            ph = aSize(4);

            sw = obj.Limits(3) - obj.Limits(1); 
            sh = obj.Limits(4) - obj.Limits(2); 
      
            sfx = pw/sw;
            sfy = ph/sh;
      
            ds = max(sfx * obj.SnakeSpeed, sfy * obj.SnakeSpeed)^2

      
       %     ds = (max(sfx, sfy) /2 * (1/.75)) ^2 * pi * obj.Speed * (1+(obj.Speed-1) * .2);
            obj.Axis.Units = cUnits;
        end
    end
end