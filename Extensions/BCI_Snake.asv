%BYB_Snake - an object for running a basic snake game
%
%Creates and updates the position of a snake drawn as a set of colored
%circles in an a Matlab axis. 
%
%mySnake BYB_Snake(ax) - initializes a new instance of the snake game 
% call mySnake the will be drawn in the matlab axis ax.  
% The snake is created with default parameters for now
% but will be update to allow more customization soon.
%
%mySnake = mySnake.Move(dir) - moves the snake on step in direction dir
%where dir can be one of 'Left', 'Right' or 'Center'. 
classdef BCI_Snake < handle
    properties
        Axis;
        Snake;
        SuccessSignal = struct(Color = "#00FF00", NFlashes = 3, FlashInterval = .25);
        FailSignal = struct(Color = "#FF0000", NFlashes = 3, FlashInterval = .25);
        
    end
    properties (Access = private)   
        Limits = [0,0,100,100];
        StartPosition = [50,50];
        SnakeDotSizeMin = 30;
        SnakeDotSizePoints = 30;
        Direction;
        InternalState = 0;
        Speed = 1;
    end
    properties (SetAccess = private)
        Version = 1.1;
        Score = 0;
        HighScore = 0;
        SnakeLength = 10;
        SnakeDataX;
        SnakeDataY;
    end
    properties (Constant = true, Access = private)
        StartLength = 10;
        Directions = {'N', "E", "S", "W"};
        IDLE = 0;
        BUSY = 1;
        RUNNING = 2;
        SUCCESS = 3;
        FAIL = 4;
    end
    properties (Dependent)
        SnakeDirection;
        SnakeState;
        SnakeSpeed;
    end
    methods
        %% contructor
        function obj = BCI_Snake(Axis)
            obj.Axis = Axis;
            obj.Axis.XLim = [obj.Limits(1),obj.Limits(3)];
            obj.Axis.YLim = [obj.Limits(2),obj.Limits(4)];
            drawnow
            pause(.5);

            obj.Snake = scatter(obj.Axis, obj.SnakeDataX, obj.SnakeDataY);
            obj.Snake.SizeData = obj.SnakeDotSizePoints;
            obj.Snake.CData = 1:obj.SnakeLength;
            obj.Snake.MarkerFaceColor = 'flat';
            obj.Snake.AlphaData = .5;

            obj.Reset();

            obj.Axis.XGrid = 'on';
            obj.Axis.YGrid = 'on';
            obj.Axis.XAxis.Visible = 'off';
            obj.Axis.YAxis.Visible = "off";  
        end
        %% ****************************************************************
        function Move(obj, direction)

            %ignore subsequent requests if the system is busy or the game
            %has ended
            if (obj.InternalState ~= obj.RUNNING)
                fprintf('NOPE');
                return; 
            end

            obj.InternalState = obj.BUSY;
            %keep track of which direction the snake is travelling 
            %can be either N, S, E or W
            if strcmp(direction,'Left')
                obj.Direction = obj.Direction - 1;
                obj.SnakeLength = obj.SnakeLength + 1;
                if obj.Direction < 1 obj.Direction = 4; end
            elseif strcmp(direction,'Right')
                obj.Direction = obj.Direction + 1;
                obj.SnakeLength = obj.SnakeLength + 1;
                if obj.Direction > 4; obj.Direction = 1; end
            end

            %create the snake tail by shifting  all the existing values down by 1
            obj.SnakeDataX(2:obj.SnakeLength) = obj.SnakeDataX(1:obj.SnakeLength-1);
            obj.SnakeDataY(2:obj.SnakeLength) = obj.SnakeDataY(1:obj.SnakeLength-1);
           
            %get the new direction by adjusting current values by the
            %object speed
            switch obj.Directions{obj.Direction}
                case "N"
                    obj.SnakeDataY(1) = obj.SnakeDataY(1) + obj.Speed;
                    if obj.SnakeDataY(1) > obj.Limits(4); obj.SnakeDataY(1) = obj.Limits(4); end
                case "S"
                    obj.SnakeDataY(1) = obj.SnakeDataY(1) - obj.Speed;
                    if obj.SnakeDataY(1) < obj.Limits(2); obj.SnakeDataY(1) = obj.Limits(2); end
                case "E"
                    obj.SnakeDataX(1) = obj.SnakeDataX(1) + obj.Speed;
                    if obj.SnakeDataX(1) > obj.Limits(3); obj.SnakeDataX(1) = obj.Limits(3); end
                case "W"
                    obj.SnakeDataX(1) = obj.SnakeDataX(1) - obj.Speed;
                    if obj.SnakeDataX(1) < obj.Limits(1); obj.SnakeDataX(1) = obj.Limits(1); end
            end

            obj.Score = obj.Score + (10 * obj.SnakeLength);
            obj.HighScore = max(obj.Score, obj.HighScore);
            if obj.isSelfCollision(obj.SnakeDataX, obj.SnakeDataY)
                fail(obj);
            end
            obj.Snake.XData = obj.SnakeDataX;
            obj.Snake.YData = obj.SnakeDataY;
            obj.Snake.CData = 1:obj.SnakeLength;

            obj.Axis.XLim = [obj.Limits(1),obj.Limits(3)];
            obj.Axis.YLim = [obj.Limits(2),obj.Limits(4)];
            %return the state to a running one unless the game ended
            if (obj.InternalState == obj.BUSY)
                obj.InternalState = obj.RUNNING;
            end
            drawnow
        end
        %% setter for the fail signal parameters
        function set.FailSignal(obj, val)
            %parameters are color, nflahses and flashinterval
            if val.NFlashes < 1 || val.NFlashes > 10
                error('EASYBCI:invalid_range','Number of flashes must be between 1 and 10');
            end
            try
                newcol = validatecolor(val.Color, 'one');
            catch ME
                error('EASYBCI:invalid_color_identifier','Color must be a valid MATLAB color specifier!');
            end
            val.Color = newcol;
            if ~isnumeric(val.FlashInterval) || val.FlashInterval <= 0 || val.FlashInterval >1
                error('EASYBCI:invalid_range', 'Flash interval must be a real positive value less than 1');
            end

            obj.FailSignal = val;
        end
        %% setter for the speed
        function set.SnakeSpeed(obj, val)
            
            if isnumeric(val) 
                val = round(val);
                if val < 1
                    val = 1;
                end
                obj.Speed = val;
            end
        end
        %% getter for the speed
        function s = get.SnakeSpeed(obj)
            s = obj.Speed;
        end
        %% getter for the direction
        function d = get.SnakeDirection(obj)
            d = obj.Directions(obj.Direction);
        end
        %% getter for the current operational state of the game
        function s = get.SnakeState(obj)
            s = obj.InternalState;
        end
                %% start the game
        function Start(obj)
            % don't let the user change the state if currently busy
            if obj.InternalState ~= obj.BUSY
                obj.InternalState = obj.RUNNING;
            end
        end
        %% reset the state of the game to initial conditions
        function Reset(obj)
            obj.SnakeLength = obj.StartLength;
            obj.SnakeDataX = ones(1,obj.SnakeLength) * obj.StartPosition(1);
            obj.SnakeDataY = ones(1,obj.SnakeLength) * obj.StartPosition(2);
            obj.Direction = 1;   
            obj.Score = 0;
            obj.InternalState = obj.IDLE;
            obj.SnakeDotSizePoints = getSnakeDotSize(obj);
            obj.Snake.SizeData = obj.SnakeDotSizePoints;
        end
    end
    methods (Access = private)
        function collided = isSelfCollision(~, X,Y)
            % a collision occurs if there is any overlap of 
            %x and y values
            if sum(X(2:end) == X(1) & Y(2:end) == Y(1)) > 0
                collided = true;
            else 
                collided = false;
            end            
        end
        function success(obj)
            obj.InternalState = obj.SUCCESS;
            flash_snake(obj, obj.SuccessSignal);
        end
        function fail(obj)
            obj.InternalState = obj.FAIL;
            flash_snake(obj, obj.FailSignal);
        end
        function flash_snake(obj, signalInfo)
            cBackup = obj.Snake.CData;
            for ii = 1:signalInfo.NFlashes
                obj.Snake.CData = validatecolor(signalInfo.Color,'one');
                pause(signalInfo.FlashInterval);
                obj.Snake.CData = cBackup;
                pause(signalInfo.FlashInterval)
            end

        end
        function ds = getSnakeDotSize(obj)

            cUnits = obj.Axis.Units;
            obj.Axis.Units = 'pixels';
            aSize = obj.Axis.Position;
            pw = aSize(3);
            ph = aSize(4);

            sw = obj.Limits(3) - obj.Limits(1); 
            sh = obj.Limits(4) - obj.Limits(2); 
            
            sfx = pw/sw;
            sfy = ph/sh;

            
            ds = (max(sfx, sfy) /2 * (1/.75)) ^2 * pi * obj.Speed * (1+(obj.Speed-1) * .2);
            obj.Axis.Units = cUnits;
        end
    end
end