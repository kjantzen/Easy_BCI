
close all
f = figure('KeyPressFcn', @kb_callback);
clf
a = axes(f);
axis equal
cla

global haveInputFlag;
global direction;

haveInputFlag = false;
direction = 'Center';

snakeGame = BCI_Snake(a);

running = true;
stepCount = 0;

while running

    pause(.1)
    if snakeGame.SnakeState == 1 %this is the ready state
        haveInputFlag = false;
        snakeGame.Move(direction);
        if haveInputFlag == false
            direction = 'Center';
        end
    elseif snakeGame.SnakeState == 3
    else
        fprintf('Missed a cycle\n');
    end
    a.Title.String = sprintf("Score: %i,  Highscore: %i", snakeGame.Score, snakeGame.HighScore);
end
function kb_callback(src, event)
   global direction
   global haveInputFlag

   if strcmp(event.Key, 'leftarrow')
       direction = 'Left';
   elseif strcmp(event.Key, 'rightarrow')
       direction = 'Right';
   end
   haveInputFlag = true;
end